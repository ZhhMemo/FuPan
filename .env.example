# ============================================================
# 复盘 · 环境变量样例（复制为 .env 使用）
# 所有变量前缀 FUPAN_，由 backend/app/config.py 的 Settings 读取。
# 未设置的变量使用 config.py 中的默认值。
# ============================================================

# ── 路径 ──
# 数据根目录（DuckDB / raw / clean / parquet 落地处）
FUPAN_DATA_ROOT=~/workspace/fupan
# API 进程以只读方式打开 market.duckdb（首次全量初始化并发时的降级开关）
FUPAN_MARKET_READONLY=0

# ── 日志 ──
FUPAN_LOG_LEVEL=INFO
FUPAN_LOG_JSON=0

# ── 定时同步（Asia/Shanghai 显式时区，每日 21:00）──
FUPAN_SYNC_HOUR=21
FUPAN_SYNC_MINUTE=0

# ── 费率参数（唯一实现 CostModel；带版本号）──
FUPAN_FEE_VERSION=v1
FUPAN_COMMISSION_RATE=0.00025
FUPAN_MIN_COMMISSION=5.0
FUPAN_STAMP_TAX_RATE=0.0005
FUPAN_TRANSFER_FEE_RATE=0.00001
FUPAN_SLIPPAGE_RATE=0.0005

# ── 数据源 ──
FUPAN_FULL_HISTORY_START=1990-12-19
FUPAN_BAOSTOCK_RECONNECT_RETRIES=3
# 基准指数（Baostock 代码）
FUPAN_DEFAULT_INDEX_CODES=["sh.000300","sh.000001","sz.399006"]

# ── 认证（M1 使用，M0 仅占位）──
FUPAN_SECRET_KEY=change-me-in-production

# ── LLM（M2 使用）──
FUPAN_LLM_API_KEY=
FUPAN_LLM_BASE_URL=https://api.deepseek.com
FUPAN_LLM_MODEL=deepseek-chat
